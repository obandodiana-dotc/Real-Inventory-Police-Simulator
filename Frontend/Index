<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Real Inventory Policy Simulator · Supply Chain Lab</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>

  <style>
    html { scroll-behavior: smooth; }
    .heat-cell {
      width: 8px;
      height: 8px;
      border-radius: 2px;
      margin: 1px;
    }
    
    .chart-container {
      position: relative;
      height: 300px;
      width: 100%;
    }
    
    .section-height {
      min-height: 350px;
    }
    
    .tall-section {
      min-height: 400px;
    }
    
    .custom-scroll {
      scrollbar-width: thin;
      scrollbar-color: #cbd5e1 #f1f5f9;
    }
    
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    
    .custom-scroll::-webkit-scrollbar-track {
      background: #f1f5f9;
      border-radius: 3px;
    }
    
    .custom-scroll::-webkit-scrollbar-thumb {
      background: #cbd5e1;
      border-radius: 3px;
    }
  </style>
</head>

<body class="bg-gray-50 min-h-screen text-gray-800">

  <!-- HEADER -->
  <header class="bg-gradient-to-r from-gray-900 via-gray-800 to-gray-900 text-white shadow-lg mb-4">
    <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="flex-1">
        <h1 id="t_header_title" class="text-2xl sm:text-3xl font-semibold">
          Real Inventory Policy Simulator
        </h1>
        <p id="t_header_subtitle" class="text-xs sm:text-sm text-gray-200 mt-1">
          Visualize how different inventory policies impact fill rate, total cost, and stockout risk.
        </p>
        <p id="t_header_steps" class="mt-2 text-[11px] text-gray-200">
          <span class="inline-flex items-center gap-1 bg-gray-800/60 px-2 py-1 rounded-full mr-1">
            <span class="text-xs">1️⃣</span><span>Define the scenario</span>
          </span>
          <span class="inline-flex items-center gap-1 bg-gray-800/60 px-2 py-1 rounded-full mr-1">
            <span class="text-xs">2️⃣</span><span>Set policies per SKU</span>
          </span>
          <span class="inline-flex items-center gap-1 bg-gray-800/60 px-2 py-1 rounded-full">
            <span class="text-xs">3️⃣</span><span>Run the simulation & read KPIs</span>
          </span>
        </p>
      </div>

      <div class="flex flex-col gap-2 items-end">
        <div class="flex items-center gap-3 text-xs">
          <div class="flex items-center gap-1">
            <span id="t_label_language" class="text-gray-200">Language</span>
            <select id="langSelector"
                    class="border border-gray-300 text-gray-800 rounded px-1.5 py-0.5 text-xs bg-white">
              <option value="en">EN</option>
              <option value="de">DE</option>
              <option value="es">ES</option>
            </select>
          </div>
          <button id="btnHealth"
                  class="text-[11px] px-2 py-1 rounded border border-green-500 text-green-100 bg-green-600/20 hover:bg-green-600/30 transition-colors">
            API ✓
          </button>
        </div>
        <p id="t_header_tagline" class="text-[10px] text-gray-300 text-right">
          Built for Supply Chain & Operations teams.
        </p>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="max-w-7xl mx-auto px-4 pb-10 space-y-6">

    <!-- TOP ROW: Scenario + SKUs + Quick Guide -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      
      <!-- SCENARIO SETUP (Izquierda) -->
      <div class="bg-white rounded-xl shadow p-4 space-y-3 border border-gray-200 section-height flex flex-col">
        <h2 id="t_scenario_setup" class="text-sm font-semibold text-gray-900">Scenario Setup</h2>

        <div class="space-y-3 flex-grow">
          <label class="block text-xs text-gray-700">
            <span id="t_label_scenario_name">Scenario name</span>
            <input id="scenarioName"
                   class="mt-1 w-full border border-gray-300 rounded px-2 py-1.5 text-xs focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none"
                   placeholder="Q4 – High variability"/>
          </label>

          <div class="grid grid-cols-2 gap-3">
            <label class="block text-xs text-gray-700">
              <span id="t_label_sim_days">Simulation days</span>
              <input id="simulationDays" type="number" min="30" max="730"
                     class="mt-1 w-full border border-gray-300 rounded px-2 py-1.5 text-xs focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none"
                     value="180"/>
            </label>
            <label class="block text-xs text-gray-700">
              <span id="t_label_service_level">Target service level</span>
              <input id="serviceLevel" type="number" step="0.01"
                     class="mt-1 w-full border border-gray-300 rounded px-2 py-1.5 text-xs focus:ring-2 focus:ring-blue-500 focus:border-blue-500 focus:outline-none"
                     value="0.95"/>
            </label>
          </div>

          <!-- SLIDERS -->
          <div class="pt-2">
            <div class="flex justify-between text-[11px] text-gray-700">
              <span id="t_label_demand_var">Demand variability (%)</span><span id="demandVarValue" class="font-semibold text-blue-600">20%</span>
            </div>
            <input id="demandVarSlider" type="range" min="5" max="60" value="20" 
                   class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-blue-500 mt-1"/>

            <div class="flex justify-between text-[11px] text-gray-700 mt-3">
              <span id="t_label_lt_var">Lead time variability (%)</span><span id="ltVarValue" class="font-semibold text-blue-600">10%</span>
            </div>
            <input id="ltVarSlider" type="range" min="0" max="60" value="10" 
                   class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer [&::-webkit-slider-thumb]:appearance-none [&::-webkit-slider-thumb]:h-4 [&::-webkit-slider-thumb]:w-4 [&::-webkit-slider-thumb]:rounded-full [&::-webkit-slider-thumb]:bg-blue-500 mt-1"/>
          </div>

          <!-- ACTION BUTTONS -->
          <div class="space-y-2 pt-3">
            <div class="grid grid-cols-2 gap-2">
              <button id="btnSimulate" class="px-3 py-1.5 rounded bg-green-600 text-white hover:bg-green-700 transition-colors font-medium text-xs">
                ▶ <span id="t_btn_run_sim">Run simulation</span>
              </button>
              <button id="btnSimulateReal" class="px-3 py-1.5 rounded bg-blue-600 text-white hover:bg-blue-700 transition-colors font-medium text-xs">
                📦 <span id="t_btn_real_skus">Real SKUs</span>
              </button>
            </div>
            <div class="grid grid-cols-2 gap-2">
              <button id="btnExportCsv" class="px-3 py-1.5 rounded border border-gray-300 text-gray-700 hover:bg-gray-50 transition-colors font-medium text-xs">
                ⬇ <span id="t_btn_export_csv">Export CSV</span>
              </button>
              <button id="btnSimulateFile" class="px-3 py-1.5 rounded bg-purple-600 text-white hover:bg-purple-700 transition-colors font-medium text-xs">
                📂 <span id="t_btn_run_file">Upload CSV</span>
              </button>
            </div>
            <!-- Input file hidden, will be triggered by button -->
            <input type="file" id="skuFile" accept=".csv" class="hidden">
          </div>
        </div>

        <!-- STATUS -->
        <p id="statusText" class="text-[11px] text-gray-500 mt-2 pt-2 border-t border-gray-200"></p>
      </div>

      <!-- SKUs (Centro) -->
      <div class="bg-white rounded-xl shadow p-4 border border-gray-200 section-height flex flex-col">
        <div class="flex justify-between items-center mb-3">
          <h2 class="text-sm font-semibold text-gray-900">SKU Configuration</h2>
          <div class="flex items-center gap-2 text-xs">
            <span id="t_viewmode_label" class="text-gray-600">View:</span>
            <div class="inline-flex rounded-full bg-gray-100 p-0.5">
              <button id="btnModeAnalyst"
                      class="px-2 py-0.5 text-[10px] rounded-full font-medium bg-gray-800 text-white">
                <span id="t_btn_analyst">Analyst</span>
              </button>
              <button id="btnModeManagement"
                      class="px-2 py-0.5 text-[10px] rounded-full font-medium text-gray-700 hover:bg-white">
                <span id="t_btn_management">Management</span>
              </button>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 flex-grow" id="sku-config-container">
          <!-- SKU 1 -->
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <h3 id="t_sku1_title" class="text-xs font-semibold text-green-700 mb-2">📈 SKU 1 — Fast mover</h3>
            
            <div class="space-y-2">
              <label class="text-xs text-gray-700">
                <span id="t_label_name1">Name</span>
                <select id="sku1_name" class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                  <option value="Sneaker – Fast mover">Sneaker – Fast mover</option>
                  <option value="Running shoe – Fast mover">Running shoe – Fast mover</option>
                  <option value="Sport T-shirt – Medium mover">Sport T-shirt – Medium mover</option>
                </select>
              </label>

              <div class="grid grid-cols-2 gap-2">
                <label class="text-xs text-gray-700">
                  <span id="t_label_annual1">Annual demand</span>
                  <input id="sku1_annual" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="24000"/>
                </label>
                <label class="text-xs text-gray-700">
                  <span id="t_label_lt1">Lead time (days)</span>
                  <input id="sku1_lt" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="7"/>
                </label>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <label class="text-xs text-gray-700">
                  <span id="t_label_unitcost1">Unit cost</span>
                  <input id="sku1_unitcost" type="number" step="0.01"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="45"/>
                </label>
                <label class="text-xs text-gray-700">
                  <span id="t_label_hold1">Holding cost (%)</span>
                  <input id="sku1_holdpct" type="number" step="0.01"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="0.25"/>
                </label>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <label class="text-xs text-gray-700">
                  <span id="t_label_order1">Order cost</span>
                  <input id="sku1_ordercost" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="80"/>
                </label>
                <label class="text-xs text-gray-700">
                  <span id="t_label_stock1">Stockout cost</span>
                  <input id="sku1_stockout" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="60"/>
                </label>
              </div>

              <label class="text-xs text-gray-700">
                <span id="t_label_policy1">Policy</span>
                <select id="sku1_policy" class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                  <option value="EOQ">EOQ</option>
                  <option value="ROP">ROP</option>
                  <option value="MINMAX">MINMAX</option>
                  <option value="PERIODIC">PERIODIC</option>
                </select>
              </label>
            </div>
          </div>

          <!-- SKU 2 -->
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <h3 id="t_sku2_title" class="text-xs font-semibold text-blue-700 mb-2">🧊 SKU 2 — Slow mover</h3>
            
            <div class="space-y-2">
              <label class="text-xs text-gray-700">
                <span id="t_label_name2">Name</span>
                <select id="sku2_name" class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                  <option value="Boot – Slow mover">Boot – Slow mover</option>
                  <option value="Work boot – Slow mover">Work boot – Slow mover</option>
                  <option value="Luxury boot – Slow mover">Luxury boot – Slow mover</option>
                </select>
              </label>

              <div class="grid grid-cols-2 gap-2">
                <label class="text-xs text-gray-700">
                  <span id="t_label_annual2">Annual demand</span>
                  <input id="sku2_annual" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="6000"/>
                </label>
                <label class="text-xs text-gray-700">
                  <span id="t_label_lt2">Lead time (days)</span>
                  <input id="sku2_lt" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="21"/>
                </label>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <label class="text-xs text-gray-700">
                  <span id="t_label_unitcost2">Unit cost</span>
                  <input id="sku2_unitcost" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="90"/>
                </label>
                <label class="text-xs text-gray-700">
                  <span id="t_label_hold2">Holding cost (%)</span>
                  <input id="sku2_holdpct" type="number" step="0.01"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="0.30"/>
                </label>
              </div>

              <div class="grid grid-cols-2 gap-2">
                <label class="text-xs text-gray-700">
                  <span id="t_label_order2">Order cost</span>
                  <input id="sku2_ordercost" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="100"/>
                </label>
                <label class="text-xs text-gray-700">
                  <span id="t_label_stock2">Stockout cost</span>
                  <input id="sku2_stockout" type="number"
                         class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none" value="120"/>
                </label>
              </div>

              <label class="text-xs text-gray-700">
                <span id="t_label_policy2">Policy</span>
                <select id="sku2_policy" class="mt-1 w-full border border-gray-300 rounded px-2 py-1 text-xs focus:ring-1 focus:ring-blue-500 focus:border-blue-500 focus:outline-none">
                  <option value="EOQ">EOQ</option>
                  <option value="ROP">ROP</option>
                  <option value="MINMAX">MINMAX</option>
                  <option value="PERIODIC">PERIODIC</option>
                </select>
              </label>
            </div>
          </div>
        </div>
      </div>

      <!-- QUICK GUIDE (Derecha) -->
      <div class="bg-white rounded-xl shadow p-4 border border-gray-200 section-height flex flex-col">
        <h2 id="t_quick_guide_title" class="text-sm font-semibold text-gray-900 mb-3">How it works · Quick guide</h2>
        
        <div class="space-y-3 flex-grow">
          <div class="flex items-start gap-3">
            <span class="h-6 w-6 rounded-full bg-blue-50 text-blue-600 flex items-center justify-center text-xs font-semibold flex-shrink-0">1</span>
            <div>
              <h3 id="t_step1_title" class="text-xs font-semibold text-gray-800">Set the scenario</h3>
              <p id="t_step1_text" class="text-[11px] text-gray-600 mt-0.5">
                Adjust simulation horizon, target service level, and variability parameters.
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <span class="h-6 w-6 rounded-full bg-green-50 text-green-600 flex items-center justify-center text-xs font-semibold flex-shrink-0">2</span>
            <div>
              <h3 id="t_step2_title" class="text-xs font-semibold text-gray-800">Configure SKUs</h3>
              <p id="t_step2_text" class="text-[11px] text-gray-600 mt-0.5">
                Define demand patterns, cost structure, lead times, and replenishment policies.
              </p>
            </div>
          </div>
          
          <div class="flex items-start gap-3">
            <span class="h-6 w-6 rounded-full bg-purple-50 text-purple-600 flex items-center justify-center text-xs font-semibold flex-shrink-0">3</span>
            <div>
              <h3 id="t_step3_title" class="text-xs font-semibold text-gray-800">Analyze results</h3>
              <p id="t_step3_text" class="text-[11px] text-gray-600 mt-0.5">
                Use KPIs, charts, heatmap, and insights to understand risks and opportunities.
              </p>
            </div>
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-gray-200">
          <h3 id="t_compare_title" class="text-xs font-semibold text-gray-800 mb-2">What the simulator compares</h3>
          <ul class="text-[11px] text-gray-600 space-y-1">
            <li id="t_compare_li1">• EOQ, ROP, Min-Max, Periodic Review</li>
            <li id="t_compare_li2">• Total cost vs Service level trade-offs</li>
            <li id="t_compare_li3">• Stockout risk by SKU and portfolio</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- MIDDLE ROW: Charts + KPIs -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      
      <!-- LEFT COLUMN: KPIs + Insights -->
      <div class="bg-white rounded-xl shadow p-4 border border-gray-200 tall-section flex flex-col">
        <h2 id="t_portfolio_kpis" class="text-sm font-semibold text-gray-900 mb-3">Portfolio Performance</h2>
        
        <!-- KPIs GRID -->
        <div class="grid grid-cols-2 gap-3 mb-4">
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <div class="flex items-center justify-between mb-1">
              <span id="t_kpi_fill_label" class="text-xs font-medium text-gray-600">Fill Rate</span>
              <i class="fas fa-percentage text-green-500 text-xs"></i>
            </div>
            <div id="kpiFillRate" class="text-xl font-bold text-green-600">--</div>
            <p id="t_kpi_fill_desc" class="text-[10px] text-gray-500 mt-1">Demand served without stockout</p>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <div class="flex items-center justify-between mb-1">
              <span id="t_kpi_total_label" class="text-xs font-medium text-gray-600">Total Cost</span>
              <i class="fas fa-euro-sign text-blue-500 text-xs"></i>
            </div>
            <div id="kpiTotalCost" class="text-xl font-bold text-gray-800">--</div>
            <p id="t_kpi_total_desc" class="text-[10px] text-gray-500 mt-1">Inventory + Ordering + Stockout</p>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <div class="flex items-center justify-between mb-1">
              <span id="t_kpi_cpu_label" class="text-xs font-medium text-gray-600">Cost per Unit</span>
              <i class="fas fa-balance-scale text-purple-500 text-xs"></i>
            </div>
            <div id="kpiCpu" class="text-xl font-bold text-gray-800">--</div>
            <p id="t_kpi_cpu_desc" class="text-[10px] text-gray-500 mt-1">Avg cost to serve one unit</p>
          </div>
          
          <div class="bg-gray-50 rounded-lg p-3 border border-gray-200">
            <div class="flex items-center justify-between mb-1">
              <span id="t_kpi_days_label" class="text-xs font-medium text-gray-600">Simulation Days</span>
              <i class="fas fa-calendar-alt text-yellow-500 text-xs"></i>
            </div>
            <div id="kpiDays" class="text-xl font-bold text-gray-800">--</div>
            <p class="text-[10px] text-gray-500 mt-1">Horizon period</p>
          </div>
        </div>

        <!-- INSIGHTS -->
        <div class="mb-3">
          <h3 id="t_insights_title" class="text-xs font-semibold text-gray-800 mb-2">
            Smart Insights
          </h3>
          <div id="insightsBox"
               class="text-[11px] text-gray-700 bg-blue-50/30 border border-blue-100 rounded-lg p-3 space-y-1 h-32 custom-scroll overflow-y-auto">
            <p id="t_insights_placeholder" class="text-[11px] text-gray-500">
              Run a simulation to see portfolio-level insights and recommendations.
            </p>
          </div>
        </div>

        <!-- POLICY ADVISOR -->
        <div class="flex-grow">
          <h3 id="t_policy_title" class="text-xs font-semibold text-gray-800 mb-2">
            Policy Advisor
          </h3>
          <div id="policyAdvisorBox"
               class="text-[11px] text-gray-700 bg-green-50/30 border border-green-100 rounded-lg p-3 space-y-1 h-32 custom-scroll overflow-y-auto">
            <p id="t_policy_placeholder" class="text-[11px] text-gray-500">
              Get personalized policy recommendations per SKU based on fill rate and cost.
            </p>
          </div>
        </div>
      </div>

      <!-- CENTER + RIGHT COLUMNS: Charts -->
      <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Cost Chart -->
        <div class="bg-white rounded-xl shadow p-4 border border-gray-200 tall-section flex flex-col">
          <div class="flex justify-between items-center mb-3">
            <h2 id="t_cost_by_sku" class="text-sm font-semibold text-gray-900">Cost Analysis by SKU</h2>
            <button class="text-xs text-gray-500 hover:text-gray-700">
              <i class="fas fa-download"></i>
            </button>
          </div>
          <div class="chart-container flex-grow">
            <canvas id="chartCost"></canvas>
          </div>
        </div>

        <!-- Fill Rate Chart -->
        <div class="bg-white rounded-xl shadow p-4 border border-gray-200 tall-section flex flex-col">
          <div class="flex justify-between items-center mb-3">
            <h2 id="t_fill_by_sku" class="text-sm font-semibold text-gray-900">Service Level by SKU</h2>
            <button class="text-xs text-gray-500 hover:text-gray-700">
              <i class="fas fa-download"></i>
